# RAGME Environment Variables
# Copy this file to .env and customize

# Paths
RAGME_HOME=/home/user/RAGme
RAGME_CONFIG_PATH=/home/user/RAGme/config
RAGME_DATA_PATH=/home/user/RAGme/data
RAGME_LOG_PATH=/home/user/RAGme/logs

# CUDA Configuration
CUDA_VISIBLE_DEVICES=0

# Model Configuration
MODEL_PATH=/home/user/RAGme/data/models/qwen2.5-vl-7b-abliterated-q4_k_m.gguf

# Database Configuration
VECTOR_DB_PATH=/home/user/RAGme/data/vector_db
REGISTRY_DB_PATH=/home/user/RAGme/data/registry.db

# API Configuration (if using REST API)
API_HOST=127.0.0.1
API_PORT=8000

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Development
DEV_MODE=false
